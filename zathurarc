# settings
set database sqlite
set window-height 1020
set window-width 900
set default-bg "#F2EBD9"
set scroll-step 200
set synctex true
#set synctex-editor-command "gvim --servername LaTeX --remote-silent +%{line} %{input}"
set synctex-editor-command "/home/fang/.vim/bin/zathura-gvim-synctex.sh %{input} %{line}"


set statusbar-bg "#ffd700"
set statusbar-fg "#000000"

##map and unmap
##map [mode] <binding> <shortcut function> <argument>
##Mode:normal (default); fullscreen; index
##unmap [mode] <binding>
unmap [normal] a
unmap j
unmap k
unmap J
unmap K
unmap t
unmap T
map [normal] j navigate next
map [normal] k navigate previous
map [normal] J scroll down
map [normal] K scroll up
map [normal] t jumplist backward
map [normal] T jumplist forward
map = zoom in
map - zoom out
map q quit
map <F2> adjust_window width
map <F4> adjust_window best-fit
